table 'CONNOTE FACT'
	lineageTag: 3af3dc7f-8e5e-4456-ae48-18aa62aed773

	measure No_POD_Scan% = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('CONNOTE FACT'),
			        'CONNOTE FACT'[POD Scan Flag] = "No"
			    ),
			    CALCULATE(
			        COUNTROWS('CONNOTE FACT'),
			        ALL('CONNOTE FACT'[c_notes_id])
			    )
			) * 100
			
			```
		lineageTag: ad3ee768-ddaa-479e-bf14-15bce36a14b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

