	partition 'CONNOTE FACT-b1e014d1-5075-4212-a41e-5da7832d42ad' = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("192.168.0.28", "DataWarehouse", [Query="SELECT *#(lf)FROM vwConnoteFact", CommandTimeout=#duration(0, 2, 30, 0)]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"DespatchDate", type date}, {"Connote Created Date", type date}, {"Invoice Date", type date}}),
				    #"POD scan flag" = Table.AddColumn(#"Changed Type", "POD Scan Flag", each if [POD Scan Date Time] = null then "No" else "Yes"),
				    #"Added Custom" = Table.AddColumn(#"POD scan flag", "Sender Postcode State", each try if Text.StartsWith([Sender Postcode], "3") then "VIC" 
				else if Text.StartsWith([Sender Postcode], "2") then "NSW" 
				else if Text.StartsWith([Sender Postcode], "4") then "QLD" 
				else if Text.StartsWith([Sender Postcode], "6") then "WA" 
				else if Text.StartsWith([Sender Postcode], "7") then "TAS"
				else if Text.StartsWith([Sender Postcode], "08") then "NT"
				else if Text.StartsWith([Sender Postcode], "09") then "NT"
				else if Text.StartsWith([Sender Postcode], "5") then "SA" else "N/A" otherwise "N/A")
				in
				    #"Added Custom"
				```

	annotation PBI_ResultType = Exception

