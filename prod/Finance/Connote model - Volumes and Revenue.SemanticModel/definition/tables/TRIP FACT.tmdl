	partition 'TRIP FACT-884704e0-5648-4063-9e0a-25633a8dfbfa' = m
		mode: import
		source =
				let
				    Source = Sql.Database("192.168.0.28", "DataWarehouse", [Query="#(lf)select #(lf)#(lf)trips.trip_no,#(lf)CAST(trips.trip_date AS DATE) DespatchDate,#(lf)CAST(trips.departed_datetime AS smalldatetime) DepartedDateTime,#(lf)--SUM(trip_trailers.trlr_cost) TrailerCost,#(lf)--MAX(trip_trailers.trl_no) TrailerNo,#(lf)trips.origin TripOrigin,#(lf)trips.driver_config 'Driver Config',#(lf)trips.subcontractor 'Subcontractor',#(lf)trips.destination TripDestination,#(lf)trips.kmsF AS 'KMsF',#(lf)trips.kmsR AS 'KMsR',#(lf)trips.kmsT AS 'KMsT'#(lf)#(lf)FROM trips#(lf)#(tab)#(tab)#(lf)    LEFT JOIN trip_trailers#(lf)#(tab)ON trips.trip_no=trip_trailers.trip_no#(lf)#(lf)#(tab)Where #(lf)#(tab)--trip_date>= dateadd(yy,-1,getDate())#(lf)#(lf)YEAR(trip_date)>=  YEAR(GETDATE()) - 1#(lf)#(tab)GROUP BY #(lf)#(lf)trips.trip_no,#(lf)cast(trips.trip_date AS DATE) ,#(lf)trips.origin ,#(lf)trips.driver_config ,#(lf)trips.subcontractor ,#(lf)trips.destination ,#(lf)trips.kmsF,#(lf)trips.kmsR,#(lf)trips.kmsT,#(lf)trips.departed_datetime#(lf)#(lf)", CommandTimeout=#duration(0, 2, 0, 0)])
				in
				    Source

