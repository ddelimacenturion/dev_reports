	partition 'Vendor DIM' = m
		mode: import
		source =
				let
				    Source = Sql.Database("192.168.0.28", "DataWarehouse", [Query="SELECT ACCOUNTNUM 'Vendor Account Number' , [name] 'Name', CASE WHEN BLOCKED = 2 THEN 'Inactive' ELSE 'Active' END 'Blocked', VENDGROUP#(lf)  FROM AX_VendorAll#(lf)  where VENDGROUP='3RD' AND LEFT(ACCOUNTNUM,1) = '9'"])
				in
				    Source

	annotation PBI_ResultType = Exception

