	measure 'Test * weeks' = ```
			
			//VAR CurrentWeek = SELECTEDVALUE('DATE DIM'[WeekDate])
			VAR NumberofWeeks = 7
			VAR LastCurrentDate = MAX ( 'DATE DIM'[WeekDate] )
			VAR Period =
			    DATESINPERIOD ( 'DATE DIM'[WeekDate], LastCurrentDate, - NumberofWeeks,DAY )
			VAR Result =
			    CALCULATE (      
			            [Total $ (Freight,Fuel Levy & Sundry)],
			        Period
			    )
			   VAR FirstDateInPeriod = MINX ( Period, 'DATE DIM'[WeekDate])
			    VAR LastDateWithSales = MAX ( 'CONNOTE FACT'[DespatchDate]  )
			//RETURN
			 //        IF ( FirstDateInPeriod <= LastDateWithSales, Result )
			RETURN
			Result
			```
