	measure TopN+Others = ```
			
			VAR _Top5 =
			    TOPN (                                                            ----Get Top 5 English Product Name by SalesAmt Descending
			        SELECTEDVALUE ( 'TopN Selection'[Value] ),
			        SUMMARIZE (                                                      ---Get the Summarize table by English Product Name & SalesAmt
			            ALL ( 'CUSTOMER DIM' ),
			            'CUSTOMER DIM'[Customer Group],
			            "Sales", [Total $ (Freight,Fuel Levy & Sundry)]
			        ),
			        [Sales]
			    )
			VAR _top5Value =                                                         ---Add the total SalesAmt of top 5 items
			    SUMX ( _Top5, [Sales] )
			VAR _Top1Value =                                                         ---Get the least Product SalesAmt from top 5 
			    MINX ( _Top5, [Sales] )
			VAR _TotalSales =                                                        ---Total Sales based on filter selection except Product filter
			    CALCULATE ( [Total $ (Freight,Fuel Levy & Sundry)], ALL ( 'CUSTOMER DIM' ) )
			VAR _SalesOthers = _TotalSales - _top5Value                              ---Total Sales - Top5 = to get others value
			VAR current_product =                                                    ---Get the Current Product Name by each row
			    SELECTEDVALUE ( 'CUSTOMER DIM'[Customer Group] )
			VAR filter_value =                                                       ---Filtering the value which are less then top 5th product value
			    IF ( [Total $ (Freight,Fuel Levy & Sundry)] < _Top1Value, BLANK (), [Total $ (Freight,Fuel Levy & Sundry)] )
			VAR result =                                                             ---result 
			    IF ( current_product = "Others", _SalesOthers + 0, filter_value )
			RETURN
			    result
			```
		formatString: #,0
		isHidden
		lineageTag: 1914ec90-93da-4018-825c-e50332d63080

		changedProperty = FormatString

		changedProperty = IsHidden

