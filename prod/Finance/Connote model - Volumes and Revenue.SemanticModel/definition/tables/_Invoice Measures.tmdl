	measure 'Last 8 weeks' = ```
			
			
			VAR CurrWk = MAX(  'DATE DIM (8 weeks)'[WeekDate] )
			
			VAR PreWk =    DATE(YEAR(CurrWk),MONTH(CurrWk),DAY(CurrWk)-49)
			
			    VAR Result =
			        CALCULATE([Total $ (Freight,Fuel Levy & Sundry)],FILTER('CONNOTE FACT','CONNOTE FACT'[DespatchDate]>=PreWk && 'CONNOTE FACT'[DespatchDate]<=CurrWk))
			RETURN
			           Result 
