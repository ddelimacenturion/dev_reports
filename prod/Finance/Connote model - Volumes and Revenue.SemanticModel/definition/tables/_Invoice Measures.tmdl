	/// Rolling 13 week Average Freight & fuel levy by Despatch date
	measure 'R13 Freight and Fuel Levy (average)' =
			
			
			VAR NumOfMonths = 91
			VAR LastCurrentDate = MAX ( 'DATE DIM'[Date] )
			VAR Period =
			    DATESINPERIOD ( 'DATE DIM'[Date], LastCurrentDate, - NumOfMonths,DAY )
			VAR Result =
			    CALCULATE (
			        AVERAGEX (
			            VALUES ( 'DATE DIM'[WeekDate] ),
			            [Total $ (Freight,Fuel Levy & Sundry)]
			        ),
			        Period
			    )
			   VAR FirstDateInPeriod = MINX ( Period, 'DATE DIM'[Date])
			    VAR LastDateWithSales = MAX ( 'CONNOTE FACT'[DespatchDate]  )
			RETURN
			         IF ( FirstDateInPeriod <= LastDateWithSales, Result )
		formatString: #,0
		isHidden
		lineageTag: d956e8af-e578-42d0-a4ac-f6ffda784c6c

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

