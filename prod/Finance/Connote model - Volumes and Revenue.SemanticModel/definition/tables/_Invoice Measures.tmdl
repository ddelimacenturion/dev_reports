		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rolling Average' = AVERAGEX(FILTER(ALLSELECTED('DATE DIM'),'DATE DIM'[Date]<=MAX('DATE DIM'[Date])),[Total $ (Freight,Fuel Levy & Sundry)])
		lineageTag: 45e05853-9ac5-4c42-ada6-fee79bc5a738

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last 8 weeks Avg' = ```
			
			
			VAR NumOfMonths = 49
			VAR LastCurrentDate = MAX ( 'DATE DIM (8 weeks)'[Date] )-7
			VAR Period =
			    DATESINPERIOD ( 'DATE DIM (8 weeks)'[Date] , LastCurrentDate, - NumOfMonths,DAY )
			
			VAR Result=
			   CALCULATE (AVERAGEX(
			        
			            VALUES ( 'DATE DIM'[WeekDate] ),
			            [Total $ (Freight,Fuel Levy & Sundry)]
			        ),
			        Period
			    )
			   VAR FirstDateInPeriod = MINX ( Period,  'DATE DIM (8 weeks)'[Date])
			    VAR LastDateWithSales = MAX ( 'CONNOTE FACT'[DespatchDate]  )
			RETURN
			         IF ( FirstDateInPeriod <= LastDateWithSales, Result )
			```
