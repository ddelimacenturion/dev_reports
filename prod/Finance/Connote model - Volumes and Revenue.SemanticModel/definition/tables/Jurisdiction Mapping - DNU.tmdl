	partition 'Jurisdiction Mapping - DNU' = m
		mode: import
		source =
				let
				    Source = Sql.Database("192.168.0.28", "DataWarehouse", [Query="#(lf)--This one is being added to Connote Model temporarily as a snowflake to facilitate easy removal later on. It's noted that Jurisdiction is not a perfectly accurate field for determining East/West split, but is being added for VM request (to help with cross-compatibility with CT Open Connotes).#(lf)#(lf)SELECT#(lf)#(tab)WM.account_no, #(lf)#(tab)WM.account_name,#(lf)#(tab)WMX.JurisdictionId,#(lf)#(tab)CASE WHEN WMX.JurisdictionId = '2' OR WMX.EastCoastCurrentCharges = 1 THEN 'EAST' ELSE 'WEST' END [Jurisdiction], --Copied from CT Open Connotes - JS221223 EAST/WEST Jursidiction#(lf)#(tab)WMX.EastCoastCurrentCharges#(lf)#(lf)from wmc_master WM#(lf)#(lf)LEFT JOIN wmc_master_extra WMX on WM.account_no = WMX.account_no", CommandTimeout=#duration(0, 0, 30, 0)]),
				    #"Temporarily Added for VM usage" = Source
				in
				    #"Temporarily Added for VM usage"

	annotation PBI_ResultType = Table

