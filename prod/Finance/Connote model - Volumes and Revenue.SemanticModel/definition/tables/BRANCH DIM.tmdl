	column 'Destination (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('BRANCH DIM'[Destination]),
				"(Blank)",
				'BRANCH DIM'[Destination] IN {"ADELAIDE",
					"ADELAIDE C"},
				"ADELAIDE",
				'BRANCH DIM'[Destination]
			)
