	partition 'BRANCH DIM-b8e7b428-0c7a-45ff-a7ca-704339d737a0' = m
		mode: import
		source =
				let
				    Source = Sql.Database("192.168.0.28", "DataWarehouse", [Query="#(tab)select #(lf)#(tab)des.destination Destination,#(lf)#(tab)DataWarehouse.dbo.branches.Suburb BranchSuburb,#(lf)#(tab)description BranchName,#(lf)#(tab)#(lf)#(tab)branch_state BranchState,#(lf)#(tab)p.Suburb,#(lf)#(tab)--p.post_code,#(lf)#(tab)p.state#(lf)#(tab)#(lf)#(tab)#(lf)#(tab)from DataWarehouse.dbo.dests des#(lf)#(lf)#(tab)left join DataWarehouse.dbo.branches on DataWarehouse.dbo.branches.branch_code = des.branch#(lf)#(tab)LEFT OUTER JOIN DataWarehouse.dbo.post_codes p on des.related_suburb = p.ref_no#(lf)WHERE is_active = 1#(lf)#(lf) --and destination like 'TENNANT CREEK'#(lf)#(lf) GROUp BY #(lf)#(lf) #(tab)des.destination ,#(lf)#(tab)DataWarehouse.dbo.branches.Suburb ,#(lf)#(tab)description ,#(tab)#(lf)#(tab)branch_state ,#(lf)#(tab)p.Suburb,#(lf)#(tab)--p.post_code,#(lf)#(tab)p.state", CommandTimeout=#duration(0, 2, 0, 0)]),
